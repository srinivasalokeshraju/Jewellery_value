{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "melt-value",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Local placeholder. The operator creates the namespace and sets its id before the first deploy.
  "kv_namespaces": [{ "binding": "RATES", "id": "00000000000000000000000000000000" }],
  "ratelimits": [{ "name": "RL", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
